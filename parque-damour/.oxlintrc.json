{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["node_modules", "dist", "shots", "scratch", ".tmp"],
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-underscore-dangle": ["warn", { "allow": ["__PD"] }],
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": ["src/core/**", "src/world/**", "src/entities/**", "src/play/**", "src/save/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/render/*", "**/audio/*", "**/ui/*", "**/debug/*", "../render/*", "../audio/*", "../ui/*", "../debug/*"],
                "message": "Layer rule (03 section 2.1): core, world, entities, play and save never import render, audio, ui or debug."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/**", "tooling/**", "vite.config.ts"],
      "env": { "node": true, "browser": false },
      "rules": { "no-console": "off" }
    },
    {
      "files": ["tests/**"],
      "env": { "node": true },
      "rules": { "no-console": "off" }
    }
  ]
}
